<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>pyyaml_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper that cross-compiles PyYAML (the YAML Python module, with its libyaml
    C extension) for VxWorks and installs it into the target site-packages.
    Depends on libyaml_vendor (ros2) for the libyaml C library. Pinned to 6.0.3
    to match Ubuntu 26.04 (resolute) python3-yaml.
  </description>
  <maintainer email="Andrei.Kholodnyi@gmail.com">Andrei Kholodnyi</maintainer>
  <license>Apache License 2.0</license> <!-- the contents of this package are Apache 2.0 -->
  <license>MIT</license>                <!-- PyYAML uses the MIT license -->

  <url type="repository">https://github.com/yaml/pyyaml</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>git</buildtool_depend>

  <depend>libyaml_vendor</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
